{
  "name": "tiku-adapter-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "serve": "vue-cli-service serve",
    "build": "vue-cli-service build",
    "lint": "vue-cli-service lint --ext .js,.jsx,.vue,.mjs,.cjs",
    "test:unit": "node --test src/utils/*.test.mjs",
    "test:components": "node --test tests/components/*.test.cjs",
    "check:sfc": "node scripts/check-sfc.cjs",
    "test:security": "node --test tests/security/*.test.cjs",
    "check:bundle": "node scripts/check-bundle.cjs dist",
    "test:integration:s02": "node scripts/run-s02-persisted-flow.cjs",
    "test:integration:s03": "node scripts/run-s03-proxy-flow.cjs",
    "test:integration:metrics": "node scripts/run-system-metrics-flow.cjs"
  },
  "dependencies": {
    "@ant-design/icons-vue": "^7.0.1",
    "ant-design-vue": "^4.2.6",
    "axios": "^1.21.1",
    "core-js": "^3.51.0",
    "echarts": "^6.1.0",
    "qrcode": "^1.5.4",
    "sweetalert2": "^11.22.0",
    "vue": "^3.5.45",
    "vue-router": "^5.4.0"
  },
  "devDependencies": {
    "@babel/core": "^8.1.0",
    "@babel/eslint-parser": "^8.0.7",
    "@vue/cli-plugin-babel": "~5.0.0",
    "@vue/cli-plugin-eslint": "~5.0.0",
    "@vue/cli-service": "~5.0.0",
    "eslint": "^10.14.0",
    "eslint-plugin-vue": "^10.12.1",
    "@vue/test-utils": "2.5.1",
    "jsdom": "31.0.0"
  },
  "eslintConfig": {
    "root": true,
    "env": {
      "browser": true,
      "es2021": true,
      "node": true
    },
    "extends": [
      "plugin:vue/essential",
      "eslint:recommended"
    ],
    "parserOptions": {
      "parser": "@babel/eslint-parser"
    },
    "rules": {}
  },
  "browserslist": [
    "> 1%",
    "last 2 versions",
    "not dead",
    "not ie 11"
  ],
  "overrides": {
    "source-map-js": "1.2.2",
    "compression": "1.8.2",
    "proxy-addr": "2.0.8",
    "qs": "6.16.1",
    "serialize-javascript": "7.1.3",
    "yorkie": {
      "cross-spawn": "6.0.6"
    },
    "@vue/component-compiler-utils": {
      "postcss": "8.5.30",
      "postcss-selector-parser": "7.1.6"
    },
    "body-parser": "1.20.9",
    "launch-editor": "2.14.2",
    "@vue/cli-service": {
      "webpack-dev-server": "5.2.7"
    },
    "webpack-dev-server@5.2.7": {
      "webpack-dev-middleware": "7.4.6",
      "selfsigned": "5.5.0"
    }
  }
}
